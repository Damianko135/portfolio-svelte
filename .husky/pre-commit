echo "🔍 Running pre-commit checks..."

# Run lint-staged on staged files
echo "📝 Running lint-staged on changed files..."
pnpm exec lint-staged || {
  echo "❌ Lint-staged failed. Please fix the issues above."
  FAILED=1
}

# Type check (run on entire project as it needs complete context)
echo "🔎 Running Svelte type check..."
pnpm run check || {
  echo "❌ Type check failed. Please fix TypeScript/Svelte errors."
  FAILED=1
}

if [ "$FAILED" ]; then
  echo "❌ Some pre-commit checks failed."
  exit 1
else
  echo "✅ All pre-commit checks passed!"
fi