#!/bin/sh

FAILED=0

echo "🔍 Running pre-commit checks..."

run_lint_staged() {
  echo "📝 Running lint-staged on changed files..."
  if ! pnpm exec lint-staged; then
    echo "❌ Lint-staged failed. Please fix the issues above."
    FAILED=1
  fi
}

run_type_check() {
  echo "🔎 Running Svelte type check..."
  if ! pnpm run check; then
    echo "❌ Type check failed. Please fix TypeScript/Svelte errors."
    FAILED=1
  fi
}

run_lint_staged
run_type_check

if [ "$FAILED" -ne 0 ]; then
  echo "❌ Some pre-commit checks failed."
  exit 1
else
  echo "✅ All pre-commit checks passed!"
fi