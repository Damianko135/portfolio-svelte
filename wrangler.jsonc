/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-svelte",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"build": {
		"command": "pnpm run build",
		"cwd": ".",
		"watch_dir": ".svelte-kit/cloudflare"
	},
	"compatibility_date": "2025-07-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "SCREENSHOTS",
			"bucket_name": "portfolio-screenshots",
			"remote": true
		}
	],
	"browser": {
		"binding": "MYBROWSER"
	}
	// Add your Resend API key as a secret using: wrangler secret put RESEND_API_KEY
	// For local development, add RESEND_API_KEY to your .env file
}