{
	"name": "portfolio-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"preview": "pnpm run build && wrangler dev",
		"build": "svelte-kit build",
		"deploy": "pnpm run check && pnpm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"test:e2e": "playwright test",
		"test": "pnpm run test:e2e",
		"playwright": "pnpm exec playwright install"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.10.0",
		"@cloudflare/workers-types": "^4.20251011.0",
		"@playwright/test": "^1.54.1",
		"@skeletonlabs/skeleton": "^3.1.7",
		"@skeletonlabs/skeleton-svelte": "^1.3.1",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.25.1",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.11",
		"@types/node": "^24.1.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.36.13",
		"svelte-check": "^4.3.0",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.8.3",
		"vite": "^7.0.5",
		"wrangler": "^4.43.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"puppeteer",
			"sharp",
			"workerd"
		]
	},
	"dependencies": {
		"@cloudflare/playwright": "^1.0.0",
		"@iconify/svelte": "^5.0.0"
	}
}
