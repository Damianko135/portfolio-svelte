{
	"name": "portfolio-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.11.1",
	"scripts": {
		"dev": "vite dev",
		"preview": "pnpm run build && wrangler dev",
		"build": "vite build",
		"deploy": "pnpm run paraglide && pnpm run check && pnpm run build && wrangler deploy",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "pnpm run format && pnpm run eslint",
		"eslint": "eslint .",
		"eslint:fix": "eslint . --fix",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"test:e2e": "playwright test",
		"test": "pnpm run test:e2e",
		"playwright": "pnpm exec playwright install",
		"paraglide": "tsx scripts/paraglide.ts"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.30.3",
		"@cloudflare/workers-types": "^4.20260401.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.15.1",
		"@playwright/test": "^1.59.1",
		"@skeletonlabs/skeleton": "^4.14.0",
		"@skeletonlabs/skeleton-svelte": "^4.14.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.5.0",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.6",
		"svelte-eslint-parser": "^1.6.0",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"wrangler": "^4.79.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"puppeteer",
			"sharp",
			"workerd"
		]
	},
	"dependencies": {
		"@cloudflare/puppeteer": "^1.0.6",
		"@iconify/svelte": "^5.2.1",
		"super-sitemap": "^1.0.7"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css,html}": [
			"prettier --write"
		]
	}
}
