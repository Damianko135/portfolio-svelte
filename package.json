{
	"name": "portfolio-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"preview": "pnpm run build && wrangler dev",
		"build": "vite build",
		"deploy": "pnpm run check && pnpm run build && wrangler deploy",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"eslint": "eslint src",
		"eslint:fix": "eslint src --fix",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"test:e2e": "playwright test",
		"test": "pnpm run test:e2e",
		"playwright": "pnpm exec playwright install",
		"paraglide": "tsx scripts/paraglide.ts"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.13.13",
		"@cloudflare/workers-types": "^4.20251011.0",
		"@eslint/js": "^9.37.0",
		"@inlang/paraglide-js": "^2.4.0",
		"@playwright/test": "^1.56.0",
		"@skeletonlabs/skeleton": "^3.2.2",
		"@skeletonlabs/skeleton-svelte": "^1.5.3",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.47.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@types/node": "^24.8.0",
		"@typescript-eslint/eslint-plugin": "^8.46.1",
		"@typescript-eslint/parser": "^8.46.1",
		"eslint": "^9.37.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.6",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.40.1",
		"svelte-check": "^4.3.3",
		"svelte-eslint-parser": "^1.3.3",
		"tailwindcss": "^4.1.14",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"wrangler": "^4.43.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"puppeteer",
			"sharp",
			"workerd"
		]
	},
	"dependencies": {
		"@cloudflare/puppeteer": "^1.0.4",
		"@iconify/svelte": "^5.0.2"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css,html}": [
			"prettier --write"
		]
	}
}
